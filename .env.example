# Copy to .env for local development. Never commit .env or real credentials.

# --- MongoDB (API / Worker / Gateway) ---
# A remote MongoDB Atlas cluster; nothing to run locally. See docs/POSTGRES_LEGACY.md for the retired Postgres setup.
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=ChangeMe

# --- API / Worker ---
# Development = accept any caller as a fixed local user (refused outside Development/Testing). Jwt = validate OIDC tokens.
Auth__Mode=Development
Auth__Authority=
Auth__Audience=daksh-api

# --- AI providers (leave empty to use the simulated mock model) ---
# Cloud models are only ever used for users who enabled "allow provider data sharing".
Ai__Anthropic__ApiKey=
Ai__OpenAI__ApiKey=
Ai__Ollama__Endpoint=

# --- External services (placeholders; adapters are mock until configured and verified) ---
Email__Provider=
Calendar__Provider=
Push__Fcm__ProjectId=
N8n__BaseUrl=
N8n__ApiKey=

# --- Agent platform (Daksh.Gateway) ---
# Base64 32-byte key used to encrypt provider credentials and other secrets at rest. Generate one with:
#   openssl rand -base64 32
Security__Encryption__Keys__k1=
Security__Encryption__ActiveKeyId=k1
# Base64-encoded signing key for access tokens (at least 32 bytes), e.g. `openssl rand -base64 48`.
Auth__Jwt__SigningKey=
Auth__Jwt__Issuer=daksh-gateway
Auth__Jwt__Audience=daksh-gateway
# Web search provider for the web_search tool: searxng | brave | tavily | none (default).
Tools__WebSearch__Provider=
Tools__WebSearch__BaseUrl=
Tools__WebSearch__ApiKey=
# off | process | container. The instance-wide ceiling for exec/code_execute tools; see docs/SECURITY.md.
Sandbox__Mode=process

# --- Telegram bot (Daksh Gateway) ---
Channels__Telegram__Enabled=false
Channels__Telegram__BotToken=NEED_TO_GET
Channels__Telegram__WebhookSecretToken=NEED_TO_GET
Channels__Telegram__WebhookPath=/api/v1/webhooks/telegram

# --- Slack app (Daksh Gateway) ---
Channels__Slack__Enabled=false
Channels__Slack__BotToken=NEED_TO_GET
Channels__Slack__SigningSecret=NEED_TO_GET
Channels__Slack__WebhookPath=/api/v1/webhooks/slack
