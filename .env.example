# Copy to .env for local development. Never commit .env or real credentials.

# --- MongoDB (API / Worker / Gateway) ---
# A remote MongoDB Atlas cluster; nothing to run locally. See docs/POSTGRES_LEGACY.md for the retired Postgres setup.
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=ChangeMe

# --- API / Worker ---
# Development = accept any caller as a fixed local user (refused outside Development/Testing). Jwt = validate OIDC tokens.
Auth__Mode=Development
Auth__Authority=
Auth__Audience=daksh-api

# --- AI providers (leave empty to use the simulated mock model) ---
# Cloud models are only ever used for users who enabled "allow provider data sharing".
Ai__Anthropic__ApiKey=
Ai__OpenAI__ApiKey=
Ai__Ollama__Endpoint=

# --- External services (placeholders; adapters are mock until configured and verified) ---
Email__Provider=
Calendar__Provider=
Push__Fcm__ProjectId=
N8n__BaseUrl=
N8n__ApiKey=

# --- Agent platform (Daksh.Gateway) ---
# Base64 32-byte key used to encrypt provider credentials and other secrets at rest. Generate one with:
#   openssl rand -base64 32
Security__Encryption__Keys__k1=
Security__Encryption__ActiveKeyId=k1
# Base64-encoded signing key for access tokens (at least 32 bytes), e.g. `openssl rand -base64 48`.
Auth__Jwt__SigningKey=
Auth__Jwt__Issuer=daksh-gateway
Auth__Jwt__Audience=daksh-gateway
# Web search provider for the web_search tool: searxng | brave | tavily | none (default).
Tools__WebSearch__Provider=
Tools__WebSearch__BaseUrl=
Tools__WebSearch__ApiKey=
# off | process | container. The instance-wide ceiling for exec/code_execute tools; see docs/SECURITY.md.
Sandbox__Mode=process

# --- Telegram bot (Daksh Gateway) ---
Channels__Telegram__Enabled=false
Channels__Telegram__BotToken=NEED_TO_GET
Channels__Telegram__WebhookSecretToken=NEED_TO_GET
Channels__Telegram__WebhookPath=/api/v1/webhooks/telegram

# --- Slack app (Daksh Gateway) ---
Channels__Slack__Enabled=false
Channels__Slack__BotToken=NEED_TO_GET
Channels__Slack__SigningSecret=NEED_TO_GET
Channels__Slack__WebhookPath=/api/v1/webhooks/slack

# --- Additional channel providers (Daksh Gateway; disabled until configured) ---
Channels__MicrosoftTeams__Enabled=false
Channels__MicrosoftTeams__BotAppId=NEED_TO_GET
Channels__MicrosoftTeams__BotAppPassword=NEED_TO_GET
Channels__MicrosoftTeams__TenantId=NEED_TO_GET
Channels__Discord__Enabled=false
Channels__Discord__BotToken=NEED_TO_GET
Channels__Discord__PublicKey=NEED_TO_GET
Channels__Discord__ApplicationId=NEED_TO_GET
Channels__GoogleChat__Enabled=false
Channels__GoogleChat__ServiceAccountJson=NEED_TO_GET
Channels__Signal__Enabled=false
Channels__Signal__BridgeBaseUrl=NEED_TO_GET
Channels__Signal__BridgeToken=NEED_TO_GET
Channels__Signal__WebhookSecret=NEED_TO_GET
Channels__Line__Enabled=false
Channels__Line__ChannelAccessToken=NEED_TO_GET
Channels__Line__ChannelSecret=NEED_TO_GET
Channels__FacebookMessenger__Enabled=false
Channels__FacebookMessenger__PageAccessToken=NEED_TO_GET
Channels__FacebookMessenger__AppSecret=NEED_TO_GET
Channels__FacebookMessenger__VerifyToken=NEED_TO_GET
Channels__InstagramMessaging__Enabled=false
Channels__InstagramMessaging__PageAccessToken=NEED_TO_GET
Channels__InstagramMessaging__AppSecret=NEED_TO_GET
Channels__InstagramMessaging__VerifyToken=NEED_TO_GET
Channels__InstagramMessaging__InstagramAccountId=NEED_TO_GET
Channels__IMessage__Enabled=false
Channels__IMessage__BridgeBaseUrl=NEED_TO_GET
Channels__IMessage__BridgeToken=NEED_TO_GET
Channels__IMessage__WebhookSecret=NEED_TO_GET
Channels__Matrix__Enabled=false
Channels__Matrix__HomeserverUrl=NEED_TO_GET
Channels__Matrix__AccessToken=NEED_TO_GET
Channels__Matrix__UserId=NEED_TO_GET
Channels__Mattermost__Enabled=false
Channels__Mattermost__BaseUrl=NEED_TO_GET
Channels__Mattermost__BotToken=NEED_TO_GET
Channels__Mattermost__WebhookSecret=NEED_TO_GET
Channels__Feishu__Enabled=false
Channels__Feishu__AppId=NEED_TO_GET
Channels__Feishu__AppSecret=NEED_TO_GET
Channels__Feishu__VerificationToken=NEED_TO_GET
Channels__Feishu__EncryptKey=NEED_TO_GET
Channels__Twitch__Enabled=false
Channels__Twitch__ClientId=NEED_TO_GET
Channels__Twitch__ClientSecret=NEED_TO_GET
Channels__Twitch__AccessToken=NEED_TO_GET
Channels__Twitch__ChannelName=NEED_TO_GET
Channels__TwilioSms__Enabled=false
Channels__TwilioSms__AccountSid=NEED_TO_GET
Channels__TwilioSms__AuthToken=NEED_TO_GET
Channels__TwilioSms__FromNumber=NEED_TO_GET

# --- Google Drive / Docs / Sheets / Slides ---
# No new settings: these use the Gmail OAuth client (Gmail__OAuth__*). See docs/integrations/google-workspace.md.

# --- Slack (docs/integrations/slack.md) ---
Slack__OAuth__ClientId=NEED_TO_GET
Slack__OAuth__ClientSecret=NEED_TO_GET
Slack__OAuth__RedirectUri=http://localhost:5080/api/integrations/slack/callback
Slack__OAuth__FrontendUrl=http://localhost:3000/apps/slack
Slack__SigningSecret=NEED_TO_GET

# --- GitHub (docs/integrations/github.md) ---
GitHub__OAuth__ClientId=NEED_TO_GET
GitHub__OAuth__ClientSecret=NEED_TO_GET
GitHub__OAuth__RedirectUri=http://localhost:5080/api/integrations/github/callback
GitHub__OAuth__FrontendUrl=http://localhost:3000/apps/github

# --- Notion (docs/integrations/notion.md) ---
Notion__OAuth__ClientId=NEED_TO_GET
Notion__OAuth__ClientSecret=NEED_TO_GET
Notion__OAuth__RedirectUri=http://localhost:5080/api/integrations/notion/callback
Notion__OAuth__FrontendUrl=http://localhost:3000/apps/notion

# --- Discord (docs/integrations/discord.md): nothing to set here; each person pastes their own bot token in the app. ---

# --- Spotify (docs/integrations/spotify.md) ---
Spotify__OAuth__ClientId=NEED_TO_GET
Spotify__OAuth__RedirectUri=http://127.0.0.1:5080/api/integrations/spotify/callback
Spotify__OAuth__FrontendUrl=http://localhost:3000/apps/spotify

