# Copy to .env on the VM (never commit the real file).

# --- Compose wiring ---
GHCR_OWNER=<github-user-or-org, lowercase>
TAG=latest
API_HOST=api.<ip-with-dashes>.sslip.io
WHATSAPP_HOST=whatsapp.<ip-with-dashes>.sslip.io
TELEGRAM_HOST=telegram.<ip-with-dashes>.sslip.io
WEB_ORIGIN=https://<your-static-web-app>.azurestaticapps.net

# --- Shared by api / whatsapp / telegram ---
MONGO_CONNECTION_STRING=
MONGO_DATABASE=
ACTIVE_ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEYS_JSON={"k1":"<base64 32-byte key>"}
INTERNAL_SERVICE_KEY=<random secret shared by the three services>

# --- API (ASP.NET config uses __ for ':') ---
Mongo__ConnectionString=<same as MONGO_CONNECTION_STRING>
Mongo__Database=<same as MONGO_DATABASE>
Security__Encryption__ActiveKeyId=k1
Security__Encryption__Keys__k1=<same base64 key>
Auth__Mode=Jwt
Auth__Jwt__SigningKey=<openssl rand -base64 48>
Integrations__Whatsapp__InternalServiceKey=<same as INTERNAL_SERVICE_KEY>
Integrations__Telegram__InternalServiceKey=<same as INTERNAL_SERVICE_KEY>
Integrations__Telegram__ApiId=
Integrations__Telegram__ApiHash=
# Add any other secrets the API needs (Gemini key, Google OAuth client, Gmail redirect URI -> https://<API_HOST>/api/integrations/gmail/callback,
# Gmail__OAuth__FrontendUrl -> <WEB_ORIGIN>/apps/gmail) as Section__Key=value lines.

# --- Telegram bridge ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
