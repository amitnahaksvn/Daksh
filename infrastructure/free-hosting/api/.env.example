# Compose wiring
GHCR_OWNER=amitnahaksvn
API_HOST=api.<ip-with-dashes>.sslip.io
# App config (ASP.NET uses __ for ':'). Real values live only on the VM.
Mongo__ConnectionString=
Mongo__Database=
Security__Encryption__ActiveKeyId=k1
Security__Encryption__Keys__k1=
Auth__Mode=Jwt
Auth__Jwt__SigningKey=
# Production mode needs an authority to start; all endpoints use the app's own login tokens, so this is only a placeholder.
Auth__Authority=https://<API_HOST>
Auth__Audience=daksh-api
Auth__Jwt__Issuer=daksh-api
Auth__Jwt__Audience=daksh-api
Integrations__Whatsapp__BaseUrl=https://whatsapp.<bridges-ip-with-dashes>.sslip.io
Integrations__Telegram__BaseUrl=https://telegram.<bridges-ip-with-dashes>.sslip.io
Integrations__Whatsapp__InternalServiceKey=
Integrations__Telegram__InternalServiceKey=
Integrations__Telegram__ApiId=
Integrations__Telegram__ApiHash=
Cors__AllowedOrigins__0=https://<static-web-app>.azurestaticapps.net
Cors__AllowedOrigins__1=https://qa.daksha.ampalab.com
Gmail__OAuth__ClientId=
Gmail__OAuth__ClientSecret=
Gmail__OAuth__RedirectUri=https://<API_HOST>/api/integrations/gmail/callback
Gmail__OAuth__FrontendUrl=https://qa.daksha.ampalab.com/apps/gmail/
Ai__Gemini__ApiKey=
Email__Gmail__User=
Email__Gmail__Password=
# Shopping carts: must equal INTERNAL_SERVICE_KEY on the bridges VM.
Integrations__Shopping__InternalServiceKey=
# Microsoft (Outlook mail/calendar, OneDrive, Azure DevOps) - see docs/integrations/microsoft.md
Microsoft__OAuth__ClientId=
Microsoft__OAuth__ClientSecret=
Microsoft__OAuth__Tenant=common
Microsoft__OAuth__RedirectUri=https://<API_HOST>/api/integrations/microsoft/callback
Microsoft__OAuth__FrontendUrl=https://qa.daksha.ampalab.com/apps/microsoft
