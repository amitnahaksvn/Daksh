{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "",
    "Database": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "",
      "Issuer": "daksh-gateway",
      "Audience": "daksh-gateway",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "Policy": {
      "MaxFailedLogins": 10,
      "LockoutMinutes": 15,
      "MinPasswordLength": 10
    }
  },
  "Security": {
    "Encryption": {
      "Keys": {},
      "ActiveKeyId": ""
    },
    "Ssrf": {
      "AllowPrivateNetworks": false,
      "AllowedPrivateHosts": []
    },
    "Command": {}
  },
  "Storage": {
    "Root": "./data",
    "MaxFileSizeBytes": 52428800
  },
  "Sandbox": {
    "Mode": "process",
    "ContainerEngine": "docker"
  },
  "Runtime": {
    "DefaultRunTimeoutSeconds": 900,
    "LeaseSeconds": 120,
    "PollIntervalMs": 500,
    "WorkerConcurrency": 4
  },
  "Scheduler": {
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 60,
    "BatchSize": 20
  },
  "Memory": {
    "EmbeddingModelRef": ""
  },
  "Tools": {
    "WebSearch": {
      "Provider": "none"
    }
  },
