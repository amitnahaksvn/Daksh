# Local shopping helper (runs on the user's own computer, drives their own Chrome).
# Must match Integrations__Shopping__InternalServiceKey on the API.
INTERNAL_SERVICE_KEY=
PORT=4300
# Where each user's browser profile (their store logins) is kept. Default: ~/.daksh/shopping
# SHOPPING_PROFILES_DIR=
# "chrome" (default), "msedge", or empty for Playwright's bundled Chromium.
# SHOPPING_BROWSER_CHANNEL=chrome
