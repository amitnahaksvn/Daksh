PORT=4200
# Shared secret the .NET API sends as X-Internal-Key. Must match Integrations:Telegram:InternalServiceKey
# in services/api/Daksh.Api/appsettings.Development.json.
INTERNAL_SERVICE_KEY=change-me

# Telegram app credentials (create once at https://my.telegram.org -> "API development tools").
# Locally they can live in services/api/Daksh.Api/appsettings.json (Integrations:Telegram:ApiId / ApiHash).
# In production supply them from your secret store instead — any of these work, highest priority first:
#   TELEGRAM_API_ID / TELEGRAM_API_HASH            plain environment variables (Docker, Kubernetes, cloud, Vault agent)
#   TELEGRAM_API_ID_FILE / TELEGRAM_API_HASH_FILE  path to a mounted secret file (Docker / Kubernetes secrets)
# The same ENV / <NAME>_FILE rule applies to INTERNAL_SERVICE_KEY, MONGO_CONNECTION_STRING,
# ENCRYPTION_KEYS_JSON and every other value in this file.

# Same MongoDB Atlas cluster/database the .NET services use.
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=ChangeMe

# Must match Security:Encryption:Keys / ActiveKeyId in Daksh.Api's appsettings.Development.json —
# this service encrypts/decrypts the Telegram session it alone owns, with the same key.
ENCRYPTION_KEYS_JSON={"k1":"change-me"}
ACTIVE_ENCRYPTION_KEY_ID=k1

DAKSH_API_BASE_URL=http://localhost:5080
