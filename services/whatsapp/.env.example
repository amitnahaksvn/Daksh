PORT=4100
# Shared secret the .NET API sends as X-Internal-Key. Must match Integrations:Whatsapp:InternalServiceKey
# in services/api/Daksh.Api/appsettings.Development.json.
INTERNAL_SERVICE_KEY=change-me

# Same MongoDB Atlas cluster/database the .NET services use.
MONGO_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=ChangeMe

# Must match Security:Encryption:Keys / ActiveKeyId in Daksh.Api's appsettings.Development.json —
# this service encrypts/decrypts the WhatsApp session material it alone owns, with the same key.
ENCRYPTION_KEYS_JSON={"k1":"change-me"}
ACTIVE_ENCRYPTION_KEY_ID=k1

DAKSH_API_BASE_URL=http://localhost:5080
